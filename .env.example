# ReviewForge 공통 환경 변수 예시 (실제 값은 .env 에 작성, 절대 커밋 금지)

# MongoDB Atlas 연결 문자열 (로컬 개발 시 docker-compose 의 mongo 사용 가능)
MONGODB_URI=mongodb://localhost:27017/reviewforge

# Spring Boot -> Flask
AI_SERVER_URL=http://localhost:5000

# JWT 서명 키 (32바이트 이상 임의 문자열)
JWT_SECRET=change-me-to-a-long-random-secret-string-32bytes+

# Next.js -> Spring Boot
BACKEND_URL=http://localhost:8080
