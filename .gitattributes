# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.md text
*.txt text
*.java text
*.js text
*.ts text
*.tsx text
*.py text
*.yml text
*.yaml text
*.json text
*.xml text
*.html text
*.css text
*.csv text
*.properties text

# Shell scripts must keep LF, Windows scripts keep CRLF.
*.sh text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.class binary
*.h5 binary
*.pkl binary
*.pt binary
